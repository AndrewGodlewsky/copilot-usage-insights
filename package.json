{
  "name": "copilot-usage-insights",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Local GitHub Copilot usage and AI credits in a desktop canvas.",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate:benchmarks": "node scripts/validate-model-benchmarks.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "benchmark:reports": "node --expose-gc scripts/benchmark-report-scale.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:local": "node scripts/build.mjs && node scripts/install-local.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "preview:demo": "node scripts/build.mjs && node scripts/preview.mjs --demo"
  }
}
